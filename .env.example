# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dander

# Authentication
JWT_SECRET=your_jwt_secret_here
ADMIN_SECRET_KEY=your_admin_secret_key_here

# Twilio (SMS — leave blank in dev to skip SMS without errors)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+10000000000

# Cloudinary (media uploads)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Platform
PLATFORM_NAME=Dander

# AI (Smart Specials photo assessment)
ANTHROPIC_API_KEY=

# Public API
API_RATE_LIMIT_PER_MINUTE=100
API_KEY_PREFIX=dnd_live_
WEBHOOK_MAX_RETRIES=10
WEBHOOK_TIMEOUT_MS=5000

# OG Image Generation
OG_IMAGE_CACHE_DIR=./public/og
DANDER_BASE_URL=https://dander.io

# Weather (Open-Meteo — free, no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# Kilo IoT Integration (added in next phase)
KILO_API_KEY=
KILO_API_URL=https://servicecenter.kiloiot.io
KILO_FOOTFALL_THRESHOLD=10
KILO_POLL_INTERVAL_MS=300000

# Redis (optional — falls back to in-memory rate limiting if not set)
REDIS_URL=
