# ── TapProve User App — Environment Variables ────────────────
# Copy this file to .env (or .env.local) for local development.
# Vars must be prefixed EXPO_PUBLIC_ to be readable in client code.

# Backend API base URL (no trailing slash).
EXPO_PUBLIC_API_URL=https://api.tapprove.io

# Override per-environment as needed:
#   .env.development → http://localhost:4000   (with adb reverse for Android emulator)
#   .env.production  → https://api.tapprove.io
