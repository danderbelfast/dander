{
  "expo": {
    "name": "TapProve",
    "slug": "tapprove",
    "scheme": "tapprove",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.tapprove.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TapProve uses your location to discover nearby offers and improve coverage.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "TapProve uses your location in the background to suggest offers as you move around.",
        "NSMotionUsageDescription": "TapProve counts your steps to reward you for exploring the high street.",
        "NSBluetoothAlwaysUsageDescription": "TapProve uses Bluetooth to recognise you at local businesses and award loyalty points automatically.",
        "NSBluetoothPeripheralUsageDescription": "TapProve uses Bluetooth to recognise you at local businesses and award loyalty points automatically."
      }
    },
    "android": {
      "package": "io.tapprove.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.VIBRATE",
        "android.permission.NFC",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            { "scheme": "https", "host": "tapprove.io", "pathPrefix": "/tap" },
            { "scheme": "https", "host": "dander.io",   "pathPrefix": "/tap" }
          ],
          "category": ["BROWSABLE", "DEFAULT"],
          "autoVerify": true
        },
        {
          "action": "VIEW",
          "data": [
            { "scheme": "https", "host": "tapprove.io", "pathPrefix": "/till" },
            { "scheme": "https", "host": "dander.io",   "pathPrefix": "/till" }
          ],
          "category": ["BROWSABLE", "DEFAULT"],
          "autoVerify": true
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "67057ff5-deb7-4b01-8c2d-5c69ec5f2399"
      }
    },
    "owner": "danderio-organization",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/67057ff5-deb7-4b01-8c2d-5c69ec5f2399"
    }
  }
}
