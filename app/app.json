{
  "expo": {
    "name": "Dander",
    "slug": "dander",
    "scheme": "dander",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.dander.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Dander uses your location to discover nearby offers and improve coverage.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Dander uses your location in the background to suggest offers as you move around.",
        "NSMotionUsageDescription": "Dander counts your steps to reward you for exploring the high street.",
        "NSBluetoothAlwaysUsageDescription": "Dander uses Bluetooth to recognise you at local businesses and award loyalty points automatically.",
        "NSBluetoothPeripheralUsageDescription": "Dander uses Bluetooth to recognise you at local businesses and award loyalty points automatically."
      }
    },
    "android": {
      "package": "io.dander.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.VIBRATE",
        "android.permission.NFC",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "dander.io",
              "pathPrefix": "/tap"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "autoVerify": true
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "dander.io",
              "pathPrefix": "/till"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "autoVerify": true
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "49294972-e974-4b31-8c3d-ee640e9adf41"
      }
    },
    "owner": "danderio-organization",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/49294972-e974-4b31-8c3d-ee640e9adf41"
    }
  }
}
