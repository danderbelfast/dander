# ============================================================
#  TapProve backend — environment variables
#
#  Copy to `.env` for local development.
#  For Railway, set these in the service's Variables tab.
#
#  Every URL has a default that matches production, so a staging
#  environment is purely an env-var operation — no code edits.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# DEPLOY_ENV labels the running deployment ("staging" / "production"
# / "development"). Independent of NODE_ENV because Node tooling
# coerces NODE_ENV to 'production' on built bundles regardless of
# which environment the service is actually deployed to — set this
# explicitly on Railway so the staging banner says 'staging'.
DEPLOY_ENV=development

# ── Database ────────────────────────────────────────────────
# Local dev: a local Postgres. Railway: the auto-injected
# DATABASE_URL from the linked Postgres service.
DATABASE_URL=postgresql://user:password@localhost:5432/dander

# ── Authentication ──────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
ADMIN_SECRET_KEY=your_admin_secret_key_here

# ── External URLs ───────────────────────────────────────────
# All four have sensible production defaults baked into
# src/config.js — set them in staging to point at the staging
# Netlify deploys instead.
USER_APP_URL=https://tapprove.io
BUSINESS_APP_URL=https://business.tapprove.io
ADMIN_APP_URL=https://admin.tapprove.io
API_PUBLIC_URL=https://api.tapprove.io

# Stripe billing-portal return. Defaults to ${USER_APP_URL}/dashboard
# so for staging just set USER_APP_URL and this follows.
# Override here only if you need a different return-to surface.
# STRIPE_PORTAL_RETURN_URL=https://tapprove.io/dashboard

# Comma-separated list of allowed CORS origins. Drives both the
# Express CORS middleware AND the Socket.IO server cors block.
# Unset → defaults to localhost dev origins (3000/3001/3002).
# Include dander.io domains too during the rename transition so the
# legacy SPA hosts stay reachable as 301 sources.
FRONTEND_URL=https://tapprove.io,https://business.tapprove.io,https://admin.tapprove.io,https://dander.io,https://biz.dander.io,https://admin.dander.io

# ── Brand ───────────────────────────────────────────────────
PLATFORM_NAME=TapProve
SUPPORT_EMAIL=support@tapprove.io
SALES_EMAIL=hello@tapprove.io

# ── Email (Resend) ──────────────────────────────────────────
# Leave blank in dev; OTP codes will print to console instead.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM=noreply@yourdomain.com

# ── SMS (Twilio) ────────────────────────────────────────────
# Leave blank in dev to skip SMS without errors.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+10000000000

# ── Media (Cloudinary) ──────────────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── AI (Anthropic) ──────────────────────────────────────────
# Leave blank to disable the dashboard assistant.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_HARDWARE_KIT=price_xxxxxxxxxxxxxxxxxxxxxxxx
# Per-plan price IDs (see services/billingService.js for the full set).

# ── Operational gates ───────────────────────────────────────
# When true, every /api/* request returns 503 except /health.
# Toggle on the Railway env without redeploying when you need to
# pull the platform offline.
# MAINTENANCE_MODE=false
