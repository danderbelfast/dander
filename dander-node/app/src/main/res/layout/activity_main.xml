<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Plain camera preview + bounding-box overlay.
         The preview MUST stay visible at full size — CameraX needs a
         live SurfaceProvider to drive the camera pipeline, and on some
         devices the ImageAnalysis use case won't receive frames at all
         when the Preview surface is GONE / 1x1. The StrangerDisplayView
         below sits LATER in this FrameLayout, has an opaque #1A1A1A
         background, and is match_parent — so it covers the preview
         visually for customers while CameraX is still happy. The
         OverlayView (bounding boxes / counting line) stays gone — that
         was operator-only chrome and isn't needed in production. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <io.dander.node.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- IN count (left) -->
    <TextView
        android:id="@+id/txtIn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:textColor="#00E676"
        android:textSize="28sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowRadius="6"
        android:text="IN 0" />

    <!-- OUT count (right) -->
    <TextView
        android:id="@+id/txtOut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:textColor="#FF7043"
        android:textSize="28sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowRadius="6"
        android:text="OUT 0" />

    <!-- Sensor HUD (bottom strip) -->
    <TextView
        android:id="@+id/txtSensors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:padding="10dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:text="initialising…" />

    <!-- LIVE indicator -->
    <TextView
        android:id="@+id/txtLive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="44dp"
        android:layout_marginEnd="16dp"
        android:background="#CC000000"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="#FF5252"
        android:textSize="12sp"
        android:textStyle="bold"
        android:text="● LIVE —" />

    <!-- Settings gear (top centre, low-key) -->
    <TextView
        android:id="@+id/btnSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_margin="14dp"
        android:padding="6dp"
        android:background="#66000000"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:text="⚙"
        android:clickable="true"
        android:focusable="true" />

    <!-- Direction toggle. Rotation now happens automatically via
         OrientationEventListener so there's no rotate button — this is
         just the invert control, rendered as monospace text so the
         arrow makes the IN direction unambiguous at a glance. -->
    <TextView
        android:id="@+id/btnInvert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="44dp"
        android:padding="8dp"
        android:background="#CC000000"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:text="IN: →"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Tap to flip IN / OUT direction" />

    <!-- Queue HUD — only shown when zone_type == "till". Positioned
         beneath the IN/OUT counts; MainActivity flips its visibility. -->
    <LinearLayout
        android:id="@+id/queueHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="58dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#CC000000"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtQueueDepth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#00E676"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtQueueLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="in queue"
            android:textColor="#BDBDBD"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtTillMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mode: Overhead"
            android:textColor="#90A4AE"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <ProgressBar
            android:id="@+id/queueBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0" />
    </LinearLayout>

    <!-- Store-closed overlay (shown outside business hours) -->
    <FrameLayout
        android:id="@+id/closedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Store closed"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNextOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#BDBDBD"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Stranger-display — full-screen idle state. This IS the customer-
         facing view; the camera preview is permanently hidden behind it.
         MainActivity flips this GONE only while the loyalty-greeting
         overlay (DisplayMode) or a state overlay (closed / paused) is up. -->
    <io.dander.node.StrangerDisplayView
        android:id="@+id/strangerDisplay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Operator escape hatch — appears on a 2-second long-press of the
         stranger display. Sits above the kiosk content but BELOW the
         loyalty greeting overlay so a customer-facing GIF still wins
         the screen if one arrives. -->
    <FrameLayout
        android:id="@+id/operatorPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:background="@android:color/transparent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#CC0F1118">

            <TextView
                android:id="@+id/opIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:textColor="#00E676"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="IN 0" />

            <TextView
                android:id="@+id/opOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:textColor="#FF7043"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="OUT 0" />

            <TextView
                android:id="@+id/opCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:text="Camera: …" />

            <TextView
                android:id="@+id/opBle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:text="BLE: …" />

            <TextView
                android:id="@+id/opNfc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:text="NFC: …" />

            <Button
                android:id="@+id/opSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Settings ⚙️" />

            <Button
                android:id="@+id/opClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="✕" />
        </LinearLayout>
    </FrameLayout>

    <!-- Loyalty greeting overlay — full-screen GIF + customer name. -->
    <io.dander.node.DisplayModeView
        android:id="@+id/displayMode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Remote-pause overlay (shown when the dashboard has toggled counting off) -->
    <FrameLayout
        android:id="@+id/pausedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6101820"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paused remotely"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Counting disabled by the business dashboard."
                android:textColor="#9FB3C8"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
