<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F0F12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Business hours -->
        <TextView style="@style/SectionLabel" android:text="Business hours" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                android:text="Opens" android:textColor="#BDBDBD" />
            <Button android:id="@+id/btnOpen"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="09:00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">
            <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                android:text="Closes" android:textColor="#BDBDBD" />
            <Button android:id="@+id/btnClose"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="18:00" />
        </LinearLayout>

        <!-- Display -->
        <TextView style="@style/SectionLabel" android:text="Display" />
        <Switch
            android:id="@+id/switchSound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Play greeting sound"
            android:textColor="#FFFFFF"
            android:checked="true" />

        <!-- Brightness -->
        <TextView style="@style/SectionLabel" android:text="Display brightness" />
        <TextView android:id="@+id/lblBrightness"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:text="20%" />
        <SeekBar android:id="@+id/seekBrightness"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="100" />

        <!-- Frame interval -->
        <TextView style="@style/SectionLabel" android:text="Process every Nth frame" />
        <RadioGroup android:id="@+id/groupFrames"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/frame3"  android:text="3rd"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/frame5"  android:text="5th"
                android:textColor="#FFFFFF"
                android:layout_marginStart="16dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/frame10" android:text="10th"
                android:textColor="#FFFFFF"
                android:layout_marginStart="16dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </RadioGroup>

        <!-- WiFi interval -->
        <TextView style="@style/SectionLabel" android:text="WiFi scan interval (minutes)" />
        <EditText android:id="@+id/editWifi"
            android:layout_width="120dp" android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="#FFFFFF" />

        <!-- Camera -->
        <TextView style="@style/SectionLabel" android:text="Camera" />
        <RadioGroup android:id="@+id/groupCamera"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton android:id="@+id/camBack"
                android:text="Rear camera (ceiling / high mount)"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/camFront"
                android:text="Front camera (wall mount — screen faces outward)"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </RadioGroup>

        <!-- Zone -->
        <TextView style="@style/SectionLabel" android:text="Zone" />
        <EditText android:id="@+id/editZoneName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Zone name (e.g. Front entrance)"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666" />
        <Spinner android:id="@+id/spinnerZoneType"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <!-- Till-only section. SettingsActivity flips its visibility when
             the zone type spinner changes. -->
        <LinearLayout
            android:id="@+id/tillSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView style="@style/SectionLabel" android:text="Till counting mode" />
            <RadioGroup android:id="@+id/groupTillMode"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton android:id="@+id/tillOverhead" android:text="Overhead — phone above, horizontal line"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <RadioButton android:id="@+id/tillWalkpast" android:text="Walk past — row of tills, vertical line"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <RadioButton android:id="@+id/tillApproach" android:text="Approach — customer walks toward camera"
                    android:textColor="#FFFFFF"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </RadioGroup>

            <TextView style="@style/SectionLabel"
                android:text="Alert when queue reaches X people" />
            <EditText android:id="@+id/editQueueThreshold"
                android:layout_width="120dp" android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Save -->
        <Button android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Save &amp; close" />

        <!-- Re-pair: clears the business code/id from prefs and bounces
             back through Setup. Visually demoted so it's clearly a
             different intent than the primary Save action. -->
        <Button android:id="@+id/btnRepair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Re-pair business"
            android:textColor="#FF5252"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>
</ScrollView>
