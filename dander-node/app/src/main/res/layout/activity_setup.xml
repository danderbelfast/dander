<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F12">

    <!-- ── Step 1: business code ─────────────────────────────── -->
    <LinearLayout
        android:id="@+id/step1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dander Node"
            android:textColor="#9AA0A6"
            android:textSize="14sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Enter your 4-digit business code"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="The business owner can find this on their dashboard Settings page."
            android:textColor="#9AA0A6"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editCode"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="0000"
            android:textColorHint="#444444"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:fontFamily="monospace"
            android:inputType="number"
            android:maxLength="4" />

        <TextView
            android:id="@+id/codeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#9AA0A6"
            android:textSize="13sp"
            android:text="" />

        <Button
            android:id="@+id/btnConfirmCode"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Confirm" />
    </LinearLayout>

    <!-- ── Step 2: zone name + type ──────────────────────────── -->
    <LinearLayout
        android:id="@+id/step2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name this zone"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblPairedBusiness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#9AA0A6"
            android:textSize="13sp"
            android:text="" />

        <EditText
            android:id="@+id/editZoneName"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:hint="e.g. Front entrance"
            android:textColorHint="#444444"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:singleLine="true" />

        <RadioGroup
            android:id="@+id/groupZoneType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/typeEntrance" android:text="Entrance"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/typeDisplay" android:text="Display"
                android:textColor="#FFFFFF"
                android:layout_marginStart="14dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/typeTill" android:text="Till"
                android:textColor="#FFFFFF"
                android:layout_marginStart="14dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/typeGeneral" android:text="General"
                android:textColor="#FFFFFF"
                android:layout_marginStart="14dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </RadioGroup>

        <Button
            android:id="@+id/btnStartCounting"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Start counting" />
    </LinearLayout>

</FrameLayout>
