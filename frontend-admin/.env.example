# ── Dander Admin App — Environment Variables ──────────────────
# Copy this file to .env.local for local development.
# For production (Netlify), set these in Site → Environment variables.

# Backend API base URL.
# Local dev: leave empty — Vite proxy sends /api → localhost:4000
# Production: the deployed API base URL (no trailing slash)
VITE_API_URL=https://api.dander.io
