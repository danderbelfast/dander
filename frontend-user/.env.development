# ============================================================
#  frontend-user — DEVELOPMENT environment values.
#
#  Vite loads this file automatically when the mode is
#  `development` (the default for `npm run dev`). It overrides
#  the hard-coded defaults in src/config.js for the dev session
#  only — `npm run build` ignores this file and falls back to
#  src/config.js + .env.production.
#
#  Tracked in git: yes. These are not secrets, just per-app
#  localhost URLs. Operator-specific overrides go in .env.local
#  (gitignored).
# ============================================================

# This SPA's own dev origin. Drives share-URLs like /o/<offer-id>
# that get pasted into native share sheets. Without this, share
# links from a dev build point at the live production host.
VITE_PUBLIC_APP_URL=http://localhost:3000

# The business dashboard's dev origin. Surfaced as the
# "List my business free" / "Register My Business" CTAs on the
# /for-business explainer page. Without this, those CTAs send
# dev clicks straight to production business.tapprove.io.
VITE_BUSINESS_PORTAL_URL=http://localhost:3001

# Backend API base — left unset on purpose. An empty value
# lets the Vite dev proxy (see vite.config.js) rewrite /api
# requests to http://localhost:4000, so we don't have to
# duplicate it here. Set VITE_API_URL=... only when pointing
# the dev frontend at a non-local backend.
