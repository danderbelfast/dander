# ============================================================
#  TapProve user SPA (tapprove.io) — environment variables
#
#  Copy to `.env.local` for local development.
#  For Netlify (production / staging), set these in the site's
#  Environment variables panel and trigger a rebuild.
#
#  Vite only exposes vars prefixed with VITE_ to the bundle.
# ============================================================

# Backend API base URL (REST + Socket.IO transport).
#   Local dev: leave empty — vite.config proxy rewrites /api → localhost:4000.
#   Production: https://api.tapprove.io
#   Staging:    https://staging-api.tapprove.io
VITE_API_URL=https://api.tapprove.io

# Public origin of this SPA. Used to build share-URLs that get
# pasted into native share sheets and email clients — must be a
# resolvable public URL, not a relative path.
#   Production: https://tapprove.io
#   Staging:    https://staging.tapprove.io
VITE_PUBLIC_APP_URL=https://tapprove.io

# Business portal — surfaced on the "For businesses" explainer CTA.
#   Production: https://business.tapprove.io
#   Staging:    https://staging-business.tapprove.io
VITE_BUSINESS_PORTAL_URL=https://business.tapprove.io

# Outbound contact addresses (sales / demos / support).
#   Defaults inside src/config.js are hello@tapprove.io / support@tapprove.io.
# VITE_SALES_EMAIL=hello@tapprove.io
# VITE_SUPPORT_EMAIL=support@tapprove.io

# Platform / brand name shown in the SPA chrome. Defaults to 'TapProve'.
# VITE_PLATFORM_NAME=TapProve

# OpenRouteService API key for the "directions to business" feature.
# Leave blank to disable the directions button.
VITE_ORS_API_KEY=

# Firebase Cloud Messaging — web push.
# Leave blank in dev; push will silently no-op.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
