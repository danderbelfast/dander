# ============================================================
#  frontend-user — PRODUCTION environment values.
#
#  Vite loads this file automatically when the mode is
#  `production` (the default for `npm run build`).
#
#  URL vars (VITE_API_URL, VITE_PUBLIC_APP_URL,
#  VITE_BUSINESS_PORTAL_URL) used to live here but were removed
#  during the staging buildup — file-based env vars conflicted
#  with Netlify's per-site UI env vars and made it impossible to
#  point staging at staging-api without prod also picking up the
#  staging URL. URLs are now per-Netlify-site UI config; the
#  src/config.js fallbacks (production-flavoured) are the
#  backstop for any URL var that isn't set.
#
#  What's left here is genuinely environment-stable: outbound
#  contact addresses and the platform brand string. Those don't
#  vary between prod, staging, or any future per-customer demo.
#
#  Tracked in git: yes. These values are public.
# ============================================================

VITE_SALES_EMAIL=hello@tapprove.io
VITE_SUPPORT_EMAIL=support@tapprove.io
VITE_PLATFORM_NAME=TapProve
