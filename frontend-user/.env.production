# ============================================================
#  frontend-user — PRODUCTION environment values.
#
#  Vite loads this file automatically when the mode is
#  `production` (the default for `npm run build`). Values here
#  override the hard-coded defaults in src/config.js, which
#  remain as a backstop so a build with this file missing still
#  produces a working bundle.
#
#  Tracked in git: yes. Production URLs are public knowledge.
#  Staging values live on Netlify's per-site env panel — they
#  override these at build time on the staging deploy.
# ============================================================

VITE_API_URL=https://api.tapprove.io
VITE_PUBLIC_APP_URL=https://tapprove.io
VITE_BUSINESS_PORTAL_URL=https://business.tapprove.io
VITE_SALES_EMAIL=hello@tapprove.io
VITE_SUPPORT_EMAIL=support@tapprove.io
VITE_PLATFORM_NAME=TapProve
