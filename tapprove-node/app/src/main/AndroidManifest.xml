<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sensors / radios -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service — the node runs sensing/monitoring as an always-on
         foreground service so screen-off / Doze / battery-saver can't silently
         kill out-of-hours monitoring. specialUse type: a dedicated, sideloaded
         retail kiosk (not Play-distributed). Camera/microphone typed FGS cannot
         be cold-started from a background scheduled wake — disqualifying for a
         kiosk whose job IS scheduled wake — so specialUse is the correct type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Partial wake lock, held only while actively sensing (released in deep
         sleep), so the CPU keeps the monitor loop alive with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- FGS notification (Android 13+ needs the runtime grant to post it). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Location is required for WiFi/Bluetooth scan results on Android 8-11
         (including Android 9 / API 28 — every BLE operation, scan or
         advertise, is gated on ACCESS_FINE_LOCATION at that SDK level). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Bluetooth. Legacy perms for <=API 30 (Android 9-11 use these for
         both scanning and advertising), new perms for API 31+ below. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- BLE peripheral broadcasting — the Node advertises a Dander
         service UUID + its device_id so nearby Dander user apps can
         match this physical kiosk to the right business and trigger
         the loyalty greeting. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADVERTISE"
        tools:targetApi="s" />

    <!-- Some OEM Bluetooth stacks require BLUETOOTH_CONNECT even when
         we only advertise / scan and never connect; declaring it lets
         the runtime request in MainActivity actually succeed. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <!-- NFC HCE — the Node phone emulates a Type 4 NDEF tag so any
         smartphone tapped against it reads back the Dander URL. Optional
         feature so Nodes without an NFC chip still install/run; the HCE
         service silently does nothing on those devices. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.nfc.hce"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TapProveNode"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- HCE service — registered with the standard NDEF Tag AID so
             every phone's default NFC stack reads us as a regular tag. -->
        <service
            android:name=".HceBroadcaster"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apdu_service" />
        </service>

        <!-- Always-on monitoring/sensing foreground service. Owns the long-lived
             lifecycle (camera + sensors + uploader + hours/thermal loops) so it
             survives screen-off / Doze independent of any Activity. -->
        <service
            android:name=".MonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Always-on retail sensing kiosk (anonymous people counting + NFC loyalty greeter) that must run continuously during opening hours and wake on a schedule; sideloaded internal distribution, not Play-distributed." />
        </service>
    </application>
</manifest>
